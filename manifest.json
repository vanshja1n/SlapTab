{
  "manifest_version": 3,
  "name": "SlapTab",
  "description": "Blocks distracting sites after your daily limit, then makes you earn access back.",
  "version": "1.0.0",
  "permissions": ["storage", "tabs", "favicon", "idle", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/app/app-icon.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "src/options.html",
  "action": {
    "default_title": "SlapTab",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_popup": "src/options.html"
  }
}
